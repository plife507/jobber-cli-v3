{
  "name": "jobber-cli",
  "version": "3.0.0",
  "description": "TypeScript CLI for Jobber GraphQL API with automatic rate limiting and schema exploration",
  "type": "module",
  "bin": {
    "jobber": "./bin/jobber.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node bin/jobber.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "JOBBER_TEST_LIVE=1 vitest run",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.0",
    "@graphql-codegen/typescript-operations": "^4.3.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
