#!/usr/bin/env node

/**
 * Purpose: Jobber CLI Entry Point - main command router for the Jobber CLI tool
 * Inputs: Command-line arguments (commands, flags, parameters)
 * Outputs: Executed commands with formatted output, error messages, help text
 * Dependencies: command registry, logger
 */

import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import commandRegistry from '../commands/register.js';
import logger from '../lib/utils/logger.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const rawArgv = process.argv.slice(2);
const GLOBAL_MACHINE_MODE = rawArgv.includes('--machine');
const GLOBAL_NON_INTERACTIVE = rawArgv.includes('--non-interactive');

if (GLOBAL_MACHINE_MODE) {
  process.env.JOBBER_MACHINE_MODE = '1';
}
if (GLOBAL_NON_INTERACTIVE) {
  process.env.JOBBER_NON_INTERACTIVE = '1';
}

const EXIT_CODES = {
  UNKNOWN: 1,
  VALIDATION: 2,
  AUTH: 3,
  RATE_LIMIT: 4,
  NOT_FOUND: 5,
  CONFIG: 6,
  NON_INTERACTIVE: 7,
  INTERNAL: 10
};

function sanitizeErrorMessage(message) {
  let errorMessage = message || 'An error occurred';

  if (!process.env.DEBUG) {
    // Redact multi-segment absolute filesystem paths (e.g. /home/user/file, C:\Users\x).
    // Must require whitespace/quote boundary + ≥2 path segments so we don't mangle
    // user text like --dates "3/15,3/16".
    errorMessage = errorMessage.replace(
      /(^|[\s"'(])(\/(?:[A-Za-z0-9._-]+\/){1,}[A-Za-z0-9._-]+)/g,
      '$1[path]'
    );
    errorMessage = errorMessage.replace(
      /(^|[\s"'(])([A-Za-z]:\\(?:[A-Za-z0-9._-]+\\){1,}[A-Za-z0-9._-]+)/g,
      '$1[path]'
    );
    errorMessage = errorMessage.replace(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*/g, '[TOKEN]');
  }

  return errorMessage;
}

function classifyErrorCode(error) {
  const message = `${error?.message || error || ''}`.toLowerCase();

  if (
    message.includes('non-interactive') ||
    message.includes('requires a tty') ||
    message.includes('requires a browser') ||
    message.includes('run headless') ||
    message.includes('interactive prompt blocked')
  ) return 'NON_INTERACTIVE';
  if (
    message.includes('usage:') ||
    message.includes('invalid') ||
    message.includes('unknown command') ||
    message.includes('unknown action')
  ) return 'VALIDATION';
  if (
    message.includes('unauth') ||
    message.includes('authentication') ||
    (message.includes('token') && message.includes('expired')) ||
    message.includes('401')
  ) return 'AUTH';
  if (
    message.includes('throttle') ||
    message.includes('rate limit') ||
    message.includes('429') ||
    message.includes('exceeds maximum throttle budget')
  ) {
    return 'RATE_LIMIT';
  }
  if (message.includes('not found') || (message.includes('no ') && message.includes('found'))) {
    return 'NOT_FOUND';
  }
  if (message.includes('configuration') || message.includes('jobber_access_token')) {
    return 'CONFIG';
  }

  return 'INTERNAL';
}

function outputMachineEnvelope(payload) {
  const envelope = {
    ok: !!payload.ok,
    command: payload.command || null,
    data: payload.data ?? null,
    error: payload.error || null,
    meta: {
      mode: 'machine',
      timestamp: new Date().toISOString(),
      ...(payload.meta || {})
    }
  };

  process.stdout.write(`${JSON.stringify(envelope, null, 2)}\n`);
}

async function withSuppressedOutput(fn) {
  const originalConsole = {
    log: console.log,
    info: console.info,
    warn: console.warn,
    error: console.error
  };
  const originalStdoutWrite = process.stdout.write.bind(process.stdout);

  const noopConsole = () => {};
  const noopWrite = (chunk, encoding, callback) => {
    if (typeof encoding === 'function') {
      encoding();
    }
    if (typeof callback === 'function') {
      callback();
    }
    return true;
  };

  console.log = noopConsole;
  console.info = noopConsole;
  console.warn = noopConsole;
  console.error = noopConsole;
  process.stdout.write = noopWrite;

  try {
    return await fn();
  } finally {
    console.log = originalConsole.log;
    console.info = originalConsole.info;
    console.warn = originalConsole.warn;
    console.error = originalConsole.error;
    process.stdout.write = originalStdoutWrite;
  }
}

// Handle unhandled promise rejections
process.on('unhandledRejection', (reason, promise) => {
  if (process.env.JOBBER_MACHINE_MODE === '1') {
    const message = sanitizeErrorMessage(reason?.message || String(reason));
    const code = classifyErrorCode(reason);
    outputMachineEnvelope({
      ok: false,
      error: {
        code,
        message
      },
      meta: {
        exitCode: EXIT_CODES[code] || EXIT_CODES.UNKNOWN
      }
    });
    process.exit(EXIT_CODES[code] || EXIT_CODES.UNKNOWN);
  }

  logger.error(`Unhandled Promise Rejection: ${reason}`);
  if (process.env.DEBUG) {
    console.error('Promise:', promise);
    console.error('Reason:', reason);
  }
  process.exit(1);
});

// Main execution
(async () => {
  // Parse command line arguments
  const args = process.argv.slice(2);
  const machineMode = GLOBAL_MACHINE_MODE;

  if (args.length === 0) {
    if (machineMode) {
      outputMachineEnvelope({
        ok: true,
        command: 'help',
        data: { message: 'Use --help for available commands' }
      });
      process.exit(0);
    }
    await showHelp();
    process.exit(0);
  }

  const [commandName, ...commandArgs] = args;

  // Handle special commands
  if (commandName === '--help' || commandName === '-h') {
    if (machineMode) {
      outputMachineEnvelope({
        ok: true,
        command: 'help',
        data: { message: 'Use "jobber <command> --machine --non-interactive" for automation-safe execution.' }
      });
      process.exit(0);
    }
    await showHelp();
    process.exit(0);
  }

  if (commandName === '--version' || commandName === '-v') {
    if (machineMode) {
      const fs = await import('fs');
      const packagePath = join(__dirname, '..', 'package.json');
      const packageJson = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
      outputMachineEnvelope({
        ok: true,
        command: 'version',
        data: { version: packageJson.version || '1.0.0' }
      });
      process.exit(0);
    }
    await showVersion();
    process.exit(0);
  }

  // Handle exit/quit commands
  if (commandName === 'exit' || commandName === 'quit') {
    if (machineMode) {
      outputMachineEnvelope({
        ok: true,
        command: commandName,
        data: { message: 'Goodbye' }
      });
      process.exit(0);
    }
    console.log('Goodbye!');
    process.exit(0);
  }

  // Parse command arguments
  const parsedArgs = parseArgs(commandArgs, commandName);
  const isMachineMode = machineMode || !!parsedArgs.machine;
  const isNonInteractive = GLOBAL_NON_INTERACTIVE || !!parsedArgs.nonInteractive || isMachineMode;

  if (isMachineMode) {
    process.env.JOBBER_MACHINE_MODE = '1';
    parsedArgs.machine = true;
    parsedArgs.json = true;
  }
  if (isNonInteractive) {
    process.env.JOBBER_NON_INTERACTIVE = '1';
    parsedArgs.nonInteractive = true;
  }

  const CommandClass = commandRegistry.getCommand(commandName);

  if (!CommandClass) {
    if (isMachineMode) {
      outputMachineEnvelope({
        ok: false,
        command: commandName,
        error: {
          code: 'VALIDATION',
          message: sanitizeErrorMessage(`Unknown command: ${commandName}`)
        },
        meta: { exitCode: EXIT_CODES.VALIDATION }
      });
      process.exit(EXIT_CODES.VALIDATION);
    }

    logger.error(`Unknown command: ${commandName}`);
    logger.info('\nAvailable commands:');
    commandRegistry.listCommands().forEach(cmd => {
      logger.info(`  - ${cmd}`);
    });
    logger.info('\nUse "jobber --help" for more information');
    process.exit(1);
  }

  // Execute command
  const command = new CommandClass();
  try {
    const result = isMachineMode
      ? await withSuppressedOutput(() => command.run(parsedArgs))
      : await command.run(parsedArgs);

    if (isMachineMode) {
      outputMachineEnvelope({
        ok: true,
        command: commandName,
        data: result ?? null,
        meta: { exitCode: 0 }
      });
    }
    process.exit(0);
  } catch (error) {
    const errorMessage = sanitizeErrorMessage(error.message || 'An error occurred');
    const code = classifyErrorCode(error);
    const exitCode = EXIT_CODES[code] || EXIT_CODES.UNKNOWN;

    if (isMachineMode) {
      outputMachineEnvelope({
        ok: false,
        command: commandName,
        error: {
          code,
          message: errorMessage
        },
        meta: { exitCode }
      });
      process.exit(exitCode);
    }

    logger.error(`Error: ${errorMessage}`);

    if (process.env.DEBUG) {
      console.error('Stack trace:', error.stack);
    }
    process.exit(exitCode);
  } finally {
    // Cleanup client resources (event listeners, HTTP agents)
    // Previously only happened via process exit handlers since execute() was never called
    if (command.client) {
      command.client.cleanup();
    }
  }
})().catch((error) => {
  const errorMessage = sanitizeErrorMessage(error.message || 'Fatal error occurred');
  const code = classifyErrorCode(error);
  const exitCode = EXIT_CODES[code] || EXIT_CODES.UNKNOWN;

  if (process.env.JOBBER_MACHINE_MODE === '1') {
    outputMachineEnvelope({
      ok: false,
      error: {
        code,
        message: errorMessage
      },
      meta: { exitCode }
    });
    process.exit(exitCode);
  }

  logger.error(`Fatal error: ${errorMessage}`);
  if (process.env.DEBUG) {
    console.error(error.stack);
  }
  process.exit(exitCode);
});

/**
 * Convert kebab-case to camelCase
 */
function kebabToCamel(str) {
  return str.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
}

/**
 * Set a parsed arg with both kebab and camel versions
 */
function setArg(parsed, key, value) {
  parsed[key] = value;
  const camelKey = kebabToCamel(key);
  if (camelKey !== key) {
    parsed[camelKey] = value;
  }
}

/**
 * Parse command line arguments into object
 * Supports: --kebab-case, -o value, --no-flag negations
 */
function parseArgs(args, commandName) {
  const parsed = {};
  let i = 0;

  while (i < args.length) {
    const arg = args[i];
    
    if (arg.startsWith('--no-')) {
      // --no-flag negation: sets both noFlag=true and flag=false
      const flagName = arg.slice(5);
      setArg(parsed, `no-${flagName}`, true);
      setArg(parsed, flagName, false);
      // Also set camelCase versions
      parsed[`no${flagName.charAt(0).toUpperCase()}${kebabToCamel(flagName).slice(1)}`] = true;
      i += 1;
    } else if (arg.startsWith('--')) {
      const key = arg.slice(2);
      const nextArg = args[i + 1];
      
      if (nextArg && !nextArg.startsWith('-')) {
        setArg(parsed, key, nextArg);
        i += 2;
      } else {
        setArg(parsed, key, true);
        i += 1;
      }
    } else if (arg.startsWith('-') && arg.length === 2) {
      // Short flag: -o or -o value
      const key = arg.slice(1);
      const nextArg = args[i + 1];
      
      if (nextArg && !nextArg.startsWith('-')) {
        parsed[key] = nextArg;
        i += 2;
      } else {
        parsed[key] = true;
        i += 1;
      }
    } else if (arg.startsWith('-')) {
      // Multi-char short flag (legacy): -abc sets a, b, c to true
      const keys = arg.slice(1).split('');
      keys.forEach(k => { parsed[k] = true; });
      i += 1;
    } else {
      // Positional argument
      if (!parsed._positional) {
        parsed._positional = [];
      }
      parsed._positional.push(arg);
      i += 1;
    }
  }

  // Extract subcommands and positional args
  if (parsed._positional) {
    const positional = parsed._positional;
    
    // For schema command: subcommand is first positional
    if (commandName === 'schema' && positional.length > 0) {
      parsed.subcommand = positional[0];
      if (positional.length > 1) {
        parsed.type = positional[1];
      }
    }
    
    // For search/get: type and query/id are positional
    if (commandName === 'search' || commandName === 'get') {
      if (positional.length > 0) {
        parsed.type = positional[0];
      }
      if (positional.length > 1) {
        // For get command with client type, join all remaining args as the name
        if (commandName === 'get' && positional[0] === 'client') {
          parsed.id = positional.slice(1).join(' ');
        } else {
          parsed.query = positional[1];
          parsed.id = positional[1]; // For get command
        }
      }
    }
    
    // For query: query string is positional
    if (commandName === 'query' && positional.length > 0) {
      parsed.query = positional.join(' ');
    }
    
    // For token: action and token are positional
    if (commandName === 'token') {
      if (positional.length > 0) {
        parsed.action = positional[0];
      }
      if (positional.length > 1) {
        parsed.token = positional[1];
      }
    }
    
    // For report commands: job number is first positional (optional)
    if (commandName === 'creport') {
      if (positional.length > 0) {
        parsed.job = positional[0]; // Job number or ID
        parsed._positional = [positional[0]]; // Keep for backward compatibility
      }
    }
  }

  return parsed;
}

/**
 * Show help message in clean minimal format
 */
async function showHelp() {
  const { cleanHeader, cleanSection, cleanRow, colorize, boldColor, colors, calculateCleanWidth } = await import('../lib/utils/theme.js');
  const contentWidth = calculateCleanWidth();
  
  console.log(cleanHeader('📘', 'JOBBER CLI HELP', contentWidth));
  
  console.log(boldColor('Jobber CLI - GraphQL API Client', colors.blue));
  console.log(colorize('Rate Limit Management', colors.grey));
  console.log('');
  
  console.log(boldColor('Usage:', colors.blue));
  console.log(colorize('  jobber <command> [options] [arguments]', colors.lightBlue));
  console.log('');
  
  console.log(boldColor('Commands:', colors.blue));
  console.log(`  ${colorize('status', colors.blue)}                    Show throttle status and budget`);
  console.log(`  ${colorize('schema fetch', colors.blue)}               Fetch and cache GraphQL schema (~45k units)`);
  console.log(`  ${colorize('schema analyze', colors.blue)}             Analyze cached schema (no API call)`);
  console.log(`  ${colorize('schema help <Type>', colors.blue)}         Show schema information for a type`);
  console.log(`  ${colorize('search <type> <query>', colors.blue)}      Search for jobs/clients`);
  console.log(`  ${colorize('searchpp', colors.blue)}                  Interactive search jobs by PP and date range`);
  console.log(`  ${colorize('get <type> <id>', colors.blue)}           Get detailed entity information`);
  console.log(`  ${colorize('query "<query>"', colors.blue)}            Execute custom GraphQL query`);
  console.log(`  ${colorize('notes', colors.blue)}                     Display notes from recent jobs (newest first)`);
  console.log(`  ${colorize('job-note <action> ...', colors.blue)}      Create, edit, delete, or list notes on a job`);
  console.log(`  ${colorize('job-expense <action> ...', colors.blue)}   Create, edit, delete, or list expenses on a job`);
  console.log(`  ${colorize('doctor', colors.blue)}                    Validate local runtime/env/token health`);
  console.log(`  ${colorize('token check', colors.blue)}                Check token expiration status`);
  console.log(`  ${colorize('token update <token>', colors.blue)}       Update access token in .env file`);
  console.log(`  ${colorize('token oauth-authorize', colors.blue)}      OAuth browser login (writes token + refresh)`);
  console.log(`  ${colorize('token oauth-refresh', colors.blue)}       Refresh access token via OAuth`);
  console.log(`  ${colorize('creport <job>', colors.blue)}              Display profitability report in console`);
  console.log(`  ${colorize('creport <job> --html', colors.blue)}        Generate HTML profitability report for single job`);
  console.log(`  ${colorize('batch <csv>', colors.blue)}               Generate HTML report from CSV (alias: batch-html-report)`);
  console.log(`  ${colorize('sort-jobs', colors.blue)}                 Sort jobs by category (PP, PP-mix, Hybrid)`);
  console.log(`  ${colorize('exit', colors.blue)} / ${colorize('quit', colors.blue)}               Exit the CLI`);
  console.log('');
  
  console.log(boldColor('Options:', colors.blue));
  console.log(`  ${colorize('--json', colors.lightBlue)}                    Output as JSON`);
  console.log(`  ${colorize('--html', colors.lightBlue)}                    Output as HTML file (for creport command)`);
  console.log(`  ${colorize('--output, -o <path>', colors.lightBlue)}       Specify output file path (for --html)`);
  console.log(`  ${colorize('--force', colors.lightBlue)}                   Force operation (e.g., refetch schema)`);
  console.log(`  ${colorize('--file <path>', colors.lightBlue)}             Read query from file (for query command)`);
  console.log(`  ${colorize('--validate', colors.lightBlue)}                Validate query against schema (default: true)`);
  console.log(`  ${colorize('--machine', colors.lightBlue)}                 Machine-readable JSON envelope output`);
  console.log(`  ${colorize('--non-interactive', colors.lightBlue)}         Disable interactive prompts (fail fast)`);
  console.log(`  ${colorize('--help, -h', colors.lightBlue)}                Show this help message`);
  console.log(`  ${colorize('--version, -v', colors.lightBlue)}             Show version`);
  console.log('');
  
  console.log(boldColor('Examples:', colors.blue));
  console.log(colorize('  jobber status', colors.lightBlue));
  console.log(colorize('  jobber schema fetch', colors.lightBlue));
  console.log(colorize('  jobber schema help Job', colors.lightBlue));
  console.log(colorize('  jobber search jobs "12345"', colors.lightBlue));
  console.log(colorize('  jobber searchpp', colors.lightBlue));
  console.log(colorize('  jobber get job <id>', colors.lightBlue));
  console.log(colorize('  jobber query "query { jobs(first: 1) { nodes { id } } }"', colors.lightBlue));
  console.log(colorize('  jobber notes', colors.lightBlue));
  console.log(colorize('  jobber notes --limit 100 --max-notes 50', colors.lightBlue));
  console.log(colorize('  jobber job-note list 12241', colors.lightBlue));
  console.log(colorize('  jobber job-note create 12241 --message "test"', colors.lightBlue));
  console.log(colorize('  jobber job-note edit --note-id <id> --message "updated"', colors.lightBlue));
  console.log(colorize('  jobber job-note delete --note-id <id>', colors.lightBlue));
  console.log(colorize('  jobber job-expense list 12241', colors.lightBlue));
  console.log(colorize('  jobber job-expense create 12241 --title "test" --date 2026-04-17T00:00:00Z --total 1.23', colors.lightBlue));
  console.log(colorize('  jobber job-expense edit --expense-id <id> --title "updated" --date 2026-04-17T00:00:00Z --total 2.34', colors.lightBlue));
  console.log(colorize('  jobber job-expense delete --expense-id <id>', colors.lightBlue));
  console.log(colorize('  jobber doctor', colors.lightBlue));
  console.log(colorize('  jobber doctor --machine --non-interactive', colors.lightBlue));
  console.log(colorize('  jobber creport 18415', colors.lightBlue));
  console.log(colorize('  jobber creport 18415 --html', colors.lightBlue));
  console.log(colorize('  jobber creport 18415 --html --output report.html', colors.lightBlue));
  console.log(colorize('  jobber batch octpp.csv', colors.lightBlue));
  console.log('');
  
  console.log(boldColor('Rate Limits:', colors.blue));
  console.log(colorize('  All operations automatically check and wait for throttle budget.', colors.grey));
  console.log(colorize('  Use \'jobber status\' to check current budget.', colors.grey));
  console.log('');
  console.log(colorize('For more information, see: https://developer.getjobber.com/docs', colors.lightBlue));
  
  console.log('');
}

/**
 * Show version
 */
async function showVersion() {
  // Read from package.json if available
  try {
    const fs = await import('fs');
    const { fileURLToPath } = await import('url');
    const { dirname, join } = await import('path');
    const __filename = fileURLToPath(import.meta.url);
    const __dirname = dirname(__filename);
    const packagePath = join(__dirname, '..', 'package.json');
    const packageJson = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
    console.log(`jobber-cli v${packageJson.version || '1.0.0'}`);
  } catch (error) {
    console.log('jobber-cli v1.0.0');
  }
}
